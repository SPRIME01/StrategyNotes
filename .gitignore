# StrategyNotes — .gitignore

# Agent / runtime logs (OMC subtask output, etc.)
.logs/

# Agent handoff files (rewritten every session — high churn).
# Durable project state in .agents/ IS tracked (evidence.md, open_questions.md,
# specs/, plans/). .agents/lessons/ IS tracked — it is durable, not churn.
.agents/current_status.md
.agents/next_steps.md

# OMC per-session orchestration stubs (managed by the OMC system; high churn)
.omc/

# Browser automation artifacts (playwright-cli: console logs, page snapshots,
# downloaded files). Generated per run; never source.
.playwright-cli/

# Code graph index (machine-generated)
.codegraph

# Windows download artifacts
*:Zone.Identifier

# Rust / Cargo
target/
**/*.rs.bk
# Cargo.lock IS committed — StrategyNotes is an application, reproducible builds matter

# Node / pnpm
node_modules/
dist/
.vite/
.turbo/
*.tsbuildinfo
coverage/

# Tauri
src-tauri/target/
src-tauri/gen/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local env / secrets
.env
.env.*
!.env.example

# Local runtime data (the dev vault/index/daynotes created by `strategynotes serve`)
strategynotes-data/

# Tauri build artifacts (src-tauri is a standalone crate; built separately)
src-tauri/target/
src-tauri/gen/

.tmp/

# dev server runtime (pids/logs)
.run/
